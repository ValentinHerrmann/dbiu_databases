%%{init: {"fontFamily": "Liberation Sans, Arial, Helvetica, sans-serif", "theme": "base", "themeVariables": {"primaryColor": "#ffffff", "mainBkg": "#ffffff", "primaryBorderColor": "#000000", "nodeBorder": "#000000", "lineColor": "#000000", "primaryTextColor": "#000000", "textColor": "#000000", "edgeLabelBackground": "#ffffff", "fontFamily": "Liberation Sans, Arial, Helvetica, sans-serif"}, "class": {"hideEmptyMembersBox": true, "useMaxWidth": false}}}%%
classDiagram
  direction LR
  class movie {
    int id
    boolean available_globally
    Date release_date
    Date created_date
    Date modified_date
    int runtime
    String locale
    String original_title
    String title
  }
  class season {
    int id
    Date release_date
    int season_number
    Date created_date
    Date modified_date
    int runtime
    String original_title
    String title
  }
  class tv_show {
    int id
    boolean available_globally
    Date release_date
    Date created_date
    Date modified_date
    String locale
    String original_title
    String title
  }
  class view_summary {
    int id
    int cumulative_weeks_in_top10
    Date end_date
    int hours_viewed
    Date start_date
    int view_rank
    int views
    Date created_date
    Date modified_date
    String duration
  }
  season "n" --> "1" tv_show : tv_show_id
  movie "1" <-- "n" view_summary : movie_id
  view_summary "n" --> "1" season : season_id
