  String ST_NAME
  String LT_ID
  String L_ID
  String ABKUERZUNG
}

' Unidirectional foreign key associations
FLUSS --> MEER : MEER
FLUSS --> SEE : SEE
GEO_BERG --> BERG : B_NAME
GEO_BERG --> LAND : L_ID
GEO_EBENE --> EBENE : E_NAME
GEO_EBENE --> LAND : L_ID
GEO_FLUSS --> FLUSS : F_NAME
GEO_FLUSS --> LAND : L_ID
GEO_INSEL --> INSEL : I_NAME
GEO_INSEL --> LAND : L_ID
GEO_MEER --> MEER : M_NAME
GEO_MEER --> LAND : L_ID
GEO_SEE --> LAND : L_ID
GEO_WUESTE --> WUESTE : W_NAME
GEO_WUESTE --> LAND : L_ID
HAT_SITZ_IN --> ORGANISATION : ABKUERZUNG
HAT_SITZ_IN --> LAND : L_ID
HAT_SITZ_IN --> STADT : ST_NAME
LANDTEIL --> LAND : L_ID
LIEGT_AN --> MEER : M_NAME
LIEGT_AN --> SEE : S_NAME
LIEGT_AN --> FLUSS : F_NAME
LIEGT_AN --> LAND : L_ID
LIEGT_AN --> STADT : ST_NAME
STADT --> LAND : L_ID

' M:N bidirectional associations
MEER "n" -- "m" MEER : GEHT_UEBER_IN
LAND "n" -- "m" LAND : IST_BENACHBART_ZU
LAND "n" -- "m" ORGANISATION : IST_MITGLIED_VON
LAND "n" -- "m" KONTINENT : UMFASST

@enduml

