  double HOEHE
  double FLAECHE
}

class FLUSS {
  String F_NAME
  String FLUSS
  String SEE
  String MEER
  int LAENGE
  double LAENGEU
  double BREITEU
  double LAENGEM
  double BREITEM
}

class GEO_BERG {
  int id
  String L_ID
  String LT_ID
  String B_NAME
}

class GEO_EBENE {
  String LT_ID
  String L_ID
  String E_NAME
}

class GEO_FLUSS {
  int id
  String L_ID
  String LT_ID
  String F_NAME
}

class GEO_INSEL {
  String LT_ID
  String L_ID
  String I_NAME
}

class GEO_MEER {
  int id
  String LT_ID
  String L_ID
  String M_NAME
}

class GEO_SEE {
  int id
  String LT_ID
  String L_ID
  String S_NAME
}

class GEO_WUESTE {
  String LT_ID
  String L_ID
  String W_NAME
}

